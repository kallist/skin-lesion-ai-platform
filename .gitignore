# ============================================================
# Skin Cancer Image Detection WebApp — .gitignore
# ============================================================

# ---------- Secrets ----------
.env
.env.*
!.env.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# ---------- Node / Frontend ----------
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/.eslintcache
*.tsbuildinfo

# ---------- Data (large / private) ----------
data/raw/
data/external_test/
data/external_test/**/*
!data/external_test/README.md
!data/external_test/.gitkeep
*.zip
# 学校提供的原始数据集与任务书：保留在本地交付，不提交到 Git
数据/
数据.zip

# ---------- Project-origin material (kept in the private working repo only) ----------
# The public snapshot excludes the requirement document and the delivery package
# because their publication rights are unconfirmed; see private-release-exclusions.md.
# Those paths are listed here so the repository can tell "deliberately excluded" from
# "accidentally missing" (scripts/check_links.py uses this).
皮肤癌图像检测系统项目任务书V1.0.0.pdf
deliverables/docs/
docs/archive/project-origin/

# ---------- Model binaries (regenerated by training) ----------
*.pth
*.pt
*.onnx
*.ckpt
# keep lightweight model metadata under version control
!models/class_mapping.json
!models/model_meta.json

# ---------- External test staging (regenerated copies of the read-only school data) ----------
artifacts/external_test/staging/

# ---------- Database ----------
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db

# ---------- Uploaded / encrypted images ----------
uploads/
encrypted_uploads/
data/uploads/
data/encrypted_uploads/
storage/

# ---------- Logs / artifacts ----------
logs/
*.log
# Launcher runtime state (PID files + absolute paths, machine specific)
.runtime/
# artifacts are small and contain the REAL measured metrics/plots, so they are
# kept under version control (the model binaries are not).
artifacts/predictions_*.csv

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# ---------- Local scratch ----------
_audit_dataset.py
_audit_dataset.json
_scratch/
