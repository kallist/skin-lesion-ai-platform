# ============================================================
# Skin Cancer Image Detection WebApp — example environment file
# Copy to .env and fill in the secret values.  NEVER commit .env.
# ============================================================

# ---------- app ----------
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1

# ---------- server ----------
HOST=127.0.0.1
PORT=8000
# Comma-separated list of allowed browser origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- database ----------
# SQLite file lives inside backend/data (git-ignored)
DATABASE_URL=sqlite:///./data/app.sqlite3

# ---------- auth ----------
# Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE_NAME=skin_session
SESSION_TTL_HOURS=168
# MUST be true when served over HTTPS (production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300

# ---------- image privacy ----------
# Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
IMAGE_ENCRYPTION_KEY=
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=40000000
ENCRYPTED_IMAGE_DIR=./data/encrypted_uploads
TEMP_DIR=./data/tmp

# ---------- machine learning ----------
MODEL_PATH=../models/best_model.pt
INFERENCE_CONCURRENCY=2
MODEL_WARMUP=true
# auto = load the real trained checkpoint (default)
# stub = deterministic test double, ONLY for UI/E2E tests
MODEL_BACKEND=auto

# ---------- ops ----------
LOG_LEVEL=INFO
ALLOW_REGISTRATION=true
ORPHAN_SWEEP_ON_STARTUP=true
